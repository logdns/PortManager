<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PortManager.Views.PortStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PortManager.Models">

    <Grid Padding="32,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{StaticResource Query_Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{StaticResource Query_Subtitle}" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>

        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="16">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="PortSearchInput" PlaceholderText="{StaticResource Query_PortPlaceholder}"
                           Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"
                           KeyDown="PortSearch_KeyDown"/>
                <Button x:Name="SearchButton" Grid.Column="1" Style="{ThemeResource AccentButtonStyle}"
                        Click="SearchButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;"/>
                        <TextBlock x:Name="SearchButtonText" Text="{StaticResource Query_Button}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ListView x:Name="ResultsList" Grid.Row="3" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FirewallRule">
                    <Border Style="{StaticResource CardPanel}" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind DirectionDisplay}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind ProtocolDisplay}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind PortDisplay}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState" Grid.Row="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <FontIcon Glyph="&#xE721;" FontSize="36" Opacity="0.35"/>
            <TextBlock x:Name="EmptyText" Text="{StaticResource Query_Initial}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Page>
