<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PortManager.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="32,28" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="20">
            <TextBlock Text="{StaticResource About_Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{StaticResource About_Copyright}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,8">
                <Image Source="ms-appx:///Assets/Square150x150Logo.png" Width="72" Height="72"/>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{StaticResource App_Title}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{StaticResource About_Description}" Style="{StaticResource PageSubtitle}"/>
                    <TextBlock Text="{StaticResource About_Version}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <toolkit:SettingsCard Header="{StaticResource About_Features}"
                                  Description="{StaticResource About_FeatureText}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE83D;"/>
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="{StaticResource About_Frameworks}"
                                  Description="{StaticResource About_FrameworkText}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE943;"/>
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="{StaticResource About_Admin}"
                                  Description="{StaticResource About_AdminText}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;"/>
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
