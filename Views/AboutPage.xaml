<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PortManager.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640">

            <TextBlock Text="关于 / About" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE737;" FontSize="32"/>
                        <TextBlock Text="Port Manager / 电脑端口管理" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Windows 防火墙端口管理工具" Opacity="0.7"/>
                    <TextBlock Text="版本 1.0.0" Opacity="0.5" FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel Spacing="4">
                    <TextBlock Text="功能说明" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="• 添加端口规则：支持 TCP/UDP/ANY 协议，入站/出站/双向" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="• 列出已开放规则：查询所有已启用的端口放行规则" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="• 删除规则：按名称精确匹配删除" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="• 端口查询：查询指定端口的防火墙状态" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel Spacing="4">
                    <TextBlock Text="技术栈" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="• WinUI 3 (Windows App SDK)" Opacity="0.7" Margin="0,4,0,0"/>
                    <TextBlock Text="• Windows Community Toolkit" Opacity="0.7" Margin="0,4,0,0"/>
                    <TextBlock Text="• .NET 8 / C# 12" Opacity="0.7" Margin="0,4,0,0"/>
                    <TextBlock Text="• Fluent Design / Mica 材质" Opacity="0.7" Margin="0,4,0,0"/>
                    <TextBlock Text="• netsh + PowerShell 防火墙操作" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel Spacing="4">
                    <TextBlock Text="注意事项" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="• 需要以管理员身份运行" Opacity="0.7" Margin="0,4,0,0"/>
                    <TextBlock Text="• ANY 协议会自动创建 TCP + UDP 两条规则" Opacity="0.7" Margin="0,4,0,0"/>
                    <TextBlock Text="• 删除操作不可撤销，请确认后执行" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
