<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PortManager.Views.ComingSoonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
  <ScrollViewer Padding="32,24" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Spacing="12">
      <TextBlock Text="更多功能 / More features" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="扩展模块已预留统一入口 / Reserved extension modules"
                 Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8"/>

      <toolkit:SettingsExpander Header="网络连接监控 / Connection monitor"
                                Description="查看活动连接、进程和远程端点 / Inspect active connections, processes and remote endpoints">
        <toolkit:SettingsExpander.Items>
          <toolkit:SettingsCard Header="实时连接 / Live connections"
                                Description="规划中 / Planned">
            <ToggleSwitch IsEnabled="False" OffContent="Coming soon"/>
          </toolkit:SettingsCard>
          <toolkit:SettingsCard Header="进程关联 / Process mapping"
                                Description="规划中 / Planned">
            <ToggleSwitch IsEnabled="False" OffContent="Coming soon"/>
          </toolkit:SettingsCard>
        </toolkit:SettingsExpander.Items>
      </toolkit:SettingsExpander>

      <toolkit:SettingsCard Header="配置导入导出 / Import and export"
                            Description="备份与恢复防火墙规则 / Back up and restore firewall rules">
        <Button Content="规划中 / Planned" IsEnabled="False"/>
      </toolkit:SettingsCard>

      <toolkit:SettingsCard Header="日志审计 / Audit log"
                            Description="记录端口规则变更 / Track firewall rule changes">
        <Button Content="规划中 / Planned" IsEnabled="False"/>
      </toolkit:SettingsCard>
    </StackPanel>
  </ScrollViewer>
</Page>
