<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PortManager.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Padding="32,24" Spacing="12">
    <TextBlock Text="概览 / Dashboard" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="端口规则 / Rules" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="RuleCount" Text="--" FontSize="28"/>
    <TextBlock Text="已启用放行规则 / Enabled allow rules" Opacity="0.65"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="添加端口 / Add port" Click="AddPort_Click"/>
      <Button Content="端口列表 / View rules" Click="ListRules_Click"/>
      <Button Content="端口查询 / Query port" Click="PortStatus_Click"/>
    </StackPanel>
    <TextBlock Text="扩展区域 / Extension area" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/>
    <TextBlock Text="后续可加入连接监控、配置导入导出和日志审计。 / Future modules can be added here."
               TextWrapping="Wrap" Opacity="0.7"/>
  </StackPanel>
</Page>
