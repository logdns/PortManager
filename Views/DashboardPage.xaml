<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PortManager.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="920" Spacing="16">
      <TextBlock Text="概览 / Dashboard" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="快速查看防火墙状态并进入常用操作 / Monitor firewall rules and start common actions."
                 Opacity="0.65" Margin="0,0,0,8" TextWrapping="Wrap"/>
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource CardPanel}">
          <StackPanel Spacing="6"><FontIcon Glyph="&#xE737;" FontSize="24" Foreground="#1A73E8"/>
            <TextBlock Text="端口规则 / Rules" FontWeight="SemiBold"/><TextBlock x:Name="RuleCount" Text="--" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="已启用放行规则 / Enabled allow rules" Opacity="0.6" FontSize="12"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
          <StackPanel Spacing="6"><FontIcon Glyph="&#xE72E;" FontSize="24" Foreground="#137333"/>
            <TextBlock Text="服务状态 / Service" FontWeight="SemiBold"/><TextBlock Text="运行正常 / Ready" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="需要管理员权限 / Administrator required" Opacity="0.6" FontSize="12"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardPanel}">
          <StackPanel Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="24" Foreground="#E8710A"/>
            <TextBlock Text="快速添加 / Quick add" FontWeight="SemiBold"/><Button Content="添加端口 / Add port" Click="AddPort_Click" HorizontalAlignment="Left"/></StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource CardPanel}">
        <StackPanel Spacing="10">
          <TextBlock Text="常用操作 / Common actions" Style="{StaticResource SectionTitle}"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="端口列表 / View rules" Click="ListRules_Click"/>
            <Button Content="端口查询 / Query port" Click="PortStatus_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardPanel}">
        <StackPanel Spacing="6"><TextBlock Text="扩展区域 / Extension area" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="后续可在导航中加入连接监控、配置导入导出、日志审计等模块。 / Add connection monitoring, import/export and audit modules here later."
                     TextWrapping="Wrap" Opacity="0.7"/></StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
