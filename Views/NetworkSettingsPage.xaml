<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="PortManager.Views.NetworkSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded">
    <ScrollViewer Padding="32,28" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <Grid MaxWidth="900" HorizontalAlignment="Stretch" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="{StaticResource Network_Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{StaticResource Network_Subtitle}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <InfoBar x:Name="HelpBar" Grid.Row="1" IsOpen="True" IsClosable="False"
                     Severity="Informational" Title="{StaticResource Network_HelpTitle}"
                     Message="{StaticResource Network_HelpMessage}"/>

            <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{StaticResource Network_Adapter}" Style="{StaticResource SectionTitle}"/>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="AdapterSelector" Grid.Column="0" DisplayMemberPath="DisplayName"
                                  PlaceholderText="{StaticResource Network_AdapterPlaceholder}"
                                  SelectionChanged="AdapterSelector_SelectionChanged"/>
                        <Button x:Name="RefreshButton" Grid.Column="1" Click="RefreshButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="{StaticResource Network_Refresh}"/></StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="CurrentConfigText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardPanel}">
                <Grid RowSpacing="14" ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                        <TextBlock Text="{StaticResource Network_Mode}"/>
                        <ComboBox x:Name="AddressModeSelector" HorizontalAlignment="Stretch"
                                  ToolTipService.ToolTip="{StaticResource Network_ModeHelp}"
                                  SelectionChanged="AddressModeSelector_SelectionChanged">
                            <ComboBoxItem Content="{StaticResource Network_Dhcp}"/>
                            <ComboBoxItem Content="{StaticResource Network_Static}"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                        <TextBlock Text="{StaticResource Network_RouteMetric}"/>
                        <NumberBox x:Name="RouteMetricBox" Value="25" Minimum="1" Maximum="9999"
                                   SpinButtonPlacementMode="Compact"
                                   ToolTipService.ToolTip="{StaticResource Network_MetricHelp}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                        <TextBlock Text="{StaticResource Network_IpAddress}"/>
                        <TextBox x:Name="IpAddressBox" PlaceholderText="192.168.1.100"
                                 ToolTipService.ToolTip="{StaticResource Network_IpHelp}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                        <TextBlock Text="{StaticResource Network_PrefixLength}"/>
                        <NumberBox x:Name="PrefixLengthBox" Value="24" Minimum="1" Maximum="32"
                                   SpinButtonPlacementMode="Compact"
                                   ToolTipService.ToolTip="{StaticResource Network_PrefixHelp}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                        <TextBlock Text="{StaticResource Network_Gateway}"/>
                        <TextBox x:Name="GatewayBox" PlaceholderText="192.168.1.1"
                                 ToolTipService.ToolTip="{StaticResource Network_GatewayHelp}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                        <TextBlock Text="{StaticResource Network_PrimaryDns}"/>
                        <TextBox x:Name="PrimaryDnsBox" PlaceholderText="1.1.1.1"
                                 ToolTipService.ToolTip="{StaticResource Network_DnsHelp}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Spacing="6">
                        <TextBlock Text="{StaticResource Network_SecondaryDns}"/>
                        <TextBox x:Name="SecondaryDnsBox" PlaceholderText="8.8.8.8"
                                 ToolTipService.ToolTip="{StaticResource Network_DnsHelp}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                        <TextBlock Text="{StaticResource Network_DefaultRoute}"/>
                        <TextBlock Text="{StaticResource Network_DefaultRouteHelp}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <InfoBar x:Name="ValidationBar" Grid.Row="4" Grid.ColumnSpan="2" IsOpen="False" IsClosable="True" Severity="Warning"/>
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ApplyButton" Click="ApplyButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE73E;"/><TextBlock Text="{StaticResource Network_Apply}"/></StackPanel>
                        </Button>
                        <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="False" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
