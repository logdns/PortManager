<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PortManager.Views.ListRulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PortManager.Models">

    <Grid Padding="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="已开放的端口规则 / Port rules" Style="{StaticResource PageTitle}"/>
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBox x:Name="SearchBox" PlaceholderText="搜索规则名称或端口..." Width="280" TextChanged="SearchBox_TextChanged"/>
            <Button Content="刷新 / Refresh" Click="RefreshButton_Click"/>
        </StackPanel>

        <!-- 列表 -->
        <ListView
            Grid.Row="2"
            x:Name="RulesList"
            ItemsSource="{x:Bind Rules, Mode=OneWay}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="RulesList_ItemClick">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FirewallRule">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,8" Padding="16,12,16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 规则名称 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE737;" FontSize="16" VerticalAlignment="Center" Opacity="0.6"/>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- 方向标签 -->
                            <Border Grid.Column="1" CornerRadius="4" Padding="8,2,8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="#E8F0FE">
                                <TextBlock Text="{x:Bind DirectionDisplay}" FontSize="12" Foreground="#1A73E8"/>
                            </Border>

                            <!-- 协议标签 -->
                            <Border Grid.Column="2" CornerRadius="4" Padding="8,2,8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="#E6F4EA">
                                <TextBlock Text="{x:Bind ProtocolDisplay}" FontSize="12" Foreground="#137333"/>
                            </Border>

                            <!-- 端口 -->
                            <TextBlock Grid.Column="3" Text="{x:Bind LocalPort}" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#E8710A"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon Glyph="&#xE7B3;" FontSize="40" Opacity="0.35"/>
            <TextBlock Text="暂无端口规则 / No port rules" Opacity="0.65"/>
        </StackPanel>
    </Grid>
</Page>
